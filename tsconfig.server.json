{
  /*
   * De serverkant: de middleware, de serverloze functies en wat ze delen.
   *
   * Die stonden buiten elke typecontrole, want tsconfig.app.json kijkt alleen
   * naar src/. Daardoor bleven twee echte fouten staan tot ze in productie
   * omvielen. Nu loopt `npm run build` er ook overheen.
   *
   * Deze opties gelden ook voor de bouw op het platform: tsconfig.json in de
   * wortel erft ze, zodat Vercel met precies dezelfde strengheid compileert als
   * deze machine. Loopt dat uiteen, dan valt de deploy om over iets wat hier
   * schoon was.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "noEmit": true,
    "skipLibCheck": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["api", "lib", "middleware.ts"]
}
